# AI（密钥仅通过部署平台设置）
ARK_API_KEY=replace-with-secret

# 生产持久化
UPSTASH_REDIS_REST_URL=https://your-upstash.example
UPSTASH_REDIS_REST_TOKEN=replace-with-secret

# 同源与代理
CORS_ALLOW_ORIGINS=https://shanghaimedhealth.com,https://www.shanghaimedhealth.com
TRUST_PROXY_HEADERS=1
SESSION_COOKIE_NAME=smed_session

# PayPal：预发 sandbox，生产 live
PAYPAL_ENV=sandbox
PAYPAL_CLIENT_ID=replace-with-client-id
PAYPAL_CLIENT_SECRET=replace-with-secret
PAYPAL_MERCHANT_ID=replace-with-paypal-merchant-id
PAYPAL_PRICE_USD=9.90

# 上传资源限制（字节）；生产保持单 worker、单 replica
MAX_FILE_SIZE_BYTES=20971520
MAX_BATCH_SIZE_BYTES=52428800

# 找回与保留期（秒）
SESSION_TTL_SECONDS=2592000
RESULT_TTL_SECONDS=604800
PAID_RESULT_TTL_SECONDS=15552000
OTP_TTL_SECONDS=600
OTP_RESEND_SECONDS=60
OTP_MAX_ATTEMPTS=5

# 可选 SMTP；未配置时只能使用报告编号+一次性提取码
SMTP_HOST=
SMTP_PORT=587
SMTP_FROM=
SMTP_USE_TLS=true
SMTP_USE_SSL=false
SMTP_TIMEOUT_SECONDS=15
SMTP_USERNAME=
SMTP_PASSWORD=

# 本地/临时降级，不替代生产 Upstash
MEDICAL_RECORDS_TEMP_DIR=/tmp/medical-records
MEDICAL_RECORDS_DB=/tmp/medical-records/shanghaimed.db
