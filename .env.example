# Coze 国际版 API Token（服务端专用，PAT token，pat_ 前缀，约 30 天过期）
# 用于官网 Navi 聊天窗口（走 https://api.coze.com/v3/chat 接口）
COZE_API_TOKEN=your_coze_pat_token_here

# Coze 国际版 Bot ID
COZE_BOT_ID=7684227464671215669

# 兼容变量：若未配置 COZE_API_TOKEN，服务端会回退读取此值
NEXT_PUBLIC_COZE_PAT=your_coze_pat_token

# Admin Password (server-side)
ADMIN_PASSWORD=your-admin-password

# Admin Password (client-side for admin page)
NEXT_PUBLIC_ADMIN_PASSWORD=your-admin-password

# Site URL
NEXT_PUBLIC_SITE_URL=https://shanghaimedhealth.com

# Contact Email
CONTACT_EMAIL=your-email@example.com

# Feishu Webhook URL
FEISHU_WEBHOOK_URL=your-feishu-webhook-url
FEISHU_WEBHOOK_SECRET=your-feishu-webhook-secret